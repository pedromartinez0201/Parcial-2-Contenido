@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBFA
  BorderColor #24527A
  ArrowColor #24527A
  ArrowFontColor #12304A
  FontColor #12304A
  AttributeFontColor #1E293B
}
hide empty members
skinparam nodesep 50
skinparam ranksep 60
class CalculadoraEnvio {
  - estrategia: EstrategiaEnvio
  + setEstrategia(e: EstrategiaEnvio): void
  + calcular(peso: double, km: double): double
}
interface EstrategiaEnvio <<interface>> {
  + costo(peso: double, km: double): double
}
class EnvioTerrestre {
  + costo(peso: double, km: double): double
}
class EnvioAereo {
  + costo(peso: double, km: double): double
}
class RetiroSucursal {
  + costo(peso: double, km: double): double
}
CalculadoraEnvio --> "1" EstrategiaEnvio : estrategia
EstrategiaEnvio <|.. EnvioTerrestre
EstrategiaEnvio <|.. EnvioAereo
EstrategiaEnvio <|.. RetiroSucursal
@enduml
