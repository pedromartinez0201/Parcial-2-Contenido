@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBFA
  BorderColor #24527A
  ArrowColor #24527A
  ArrowFontColor #12304A
  FontColor #12304A
  AttributeFontColor #1E293B
}
hide empty members
skinparam nodesep 50
skinparam ranksep 60
class Aplicacion {
  - reproductor: ReproductorVideo
  - menu: MenuNavegacion
  + Aplicacion(f: DispositivoFactory)
  + renderizarUI(): void
}
interface DispositivoFactory <<interface>> {
  + crearReproductor(): ReproductorVideo
  + crearMenu(): MenuNavegacion
}
class SmartTVFactory
class MovilFactory
interface ReproductorVideo <<interface>> {
  + reproducir(): void
}
interface MenuNavegacion <<interface>> {
  + navegar(): void
}
class ReproductorSmartTV
class ReproductorMovil
class MenuSmartTV
class MenuMovil
Aplicacion ..> DispositivoFactory : <<usa>>
Aplicacion --> "1" ReproductorVideo : reproductor
Aplicacion --> "1" MenuNavegacion : menu
DispositivoFactory <|.. SmartTVFactory
DispositivoFactory <|.. MovilFactory
ReproductorVideo <|.. ReproductorSmartTV
ReproductorVideo <|.. ReproductorMovil
MenuNavegacion <|.. MenuSmartTV
MenuNavegacion <|.. MenuMovil
SmartTVFactory ..> ReproductorSmartTV : <<crea>>
SmartTVFactory ..> MenuSmartTV : <<crea>>
MovilFactory ..> ReproductorMovil : <<crea>>
MovilFactory ..> MenuMovil : <<crea>>
@enduml
