@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #DCEBFA
  BorderColor #24527A
  ArrowColor #24527A
  ArrowFontColor #12304A
  FontColor #12304A
  AttributeFontColor #1E293B
}
hide empty members
skinparam nodesep 45
skinparam ranksep 70
abstract class GeneradorDocumento <<abstract>> {
  + {abstract} crearDocumento(): Documento
  + exportar(): void
}
class GeneradorPDF {
  + crearDocumento(): Documento
}
class GeneradorHTML {
  + crearDocumento(): Documento
}
interface Documento <<interface>> {
  + generar(): void
}
class DocumentoPDF {
  + generar(): void
}
class DocumentoHTML {
  + generar(): void
}
GeneradorDocumento <|-- GeneradorPDF
GeneradorDocumento <|-- GeneradorHTML
Documento <|.. DocumentoPDF
Documento <|.. DocumentoHTML
GeneradorDocumento .right.> Documento : <<usa>>
GeneradorPDF ..> DocumentoPDF : <<crea>>
GeneradorHTML ..> DocumentoHTML : <<crea>>
@enduml
